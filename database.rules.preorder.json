{
  "rules": {
    "adminAccounts": {
      ".read": true,
      ".write": false
    },
    "preorders": {
      ".read": true,
      ".indexOn": [
        "customer/studentId",
        "customer/phone",
        "payment/status",
        "pickup/status"
      ],
      "$orderId": {
        ".write": true,
        ".validate": "newData.val() == null || (newData.hasChildren(['buyerType','referenceCode','customer','order','payment','status','createdAt']) && (newData.child('buyerType').val() == 'student' || newData.child('buyerType').val() == 'teacher'))",
        "buyerType": {
          ".validate": "newData.isString() && (newData.val() == 'student' || newData.val() == 'teacher')"
        },
        "customer": {
          ".validate": "(newData.parent().child('buyerType').val() == 'student' && newData.hasChildren(['prefix','firstName','lastName','studentId','level','room','phone','contact'])) || (newData.parent().child('buyerType').val() == 'teacher' && newData.hasChildren(['prefix','firstName','lastName','phone']))",
          "studentId": {
            ".validate": "!newData.exists() || (newData.isString() && newData.val().matches(/^[0-9]{5,6}$/))"
          },
          "phone": {
            ".validate": "newData.isString() && newData.val().matches(/^[0-9]{9,10}$/)"
          }
        },
        "order": {
          ".validate": "newData.hasChildren(['unitPrice','quantity','totalAmount'])",
          "unitPrice": {
            ".validate": "newData.isNumber() && newData.val() == 129"
          },
          "quantity": {
            ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10"
          },
          "totalAmount": {
            ".validate": "newData.isNumber() && newData.val() == newData.parent().child('unitPrice').val() * newData.parent().child('quantity').val()"
          }
        },
        "payment": {
          ".validate": "newData.hasChildren(['method','status','qrNumber','slipData','slipMeta'])",
          "status": {
            ".validate": "newData.isString() && (newData.val() == 'pending' || newData.val() == 'verified' || newData.val() == 'rejected')"
          }
        },
        "pickup": {
          ".validate": "!newData.exists() || (newData.parent().child('buyerType').val() == 'student' || newData.parent().child('buyerType').val() == 'teacher')"
        }
      }
    },
    "submissions": {
      ".read": true,
      "$submissionId": {
        ".write": true
      }
    },
    "siteStats": {
      ".read": true,
      ".write": true
    },
    "systemConfig": {
      ".read": true,
      ".write": true
    }
  }
}